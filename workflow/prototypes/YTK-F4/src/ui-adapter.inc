function f4PendingLabel(op){var labels={using:'利用中',not_using:'使っていない',unknown:'わからない',yes:'ある',no:'ない',unanswered:'未回答',keep:'残したい',delete:'削除したい',family:'家族に任せる',undecided:'未決定',dormant:'休眠・停止中',hidden:'知らないものあり',known:'だいたい把握',checked:'確認済み',missing:'未設定あり'};var category=C.find(c=>c.id===op.categoryKey);var target=category?.t||R2.draft?.serviceName||'整理内容';return target+'：'+(op.type==='addService'?'サービスの追加':op.type==='completeService'?'整理完了':op.type==='deleteAll'?'全削除':labels[op.value]??op.value??'回答の変更');}
var f4Ready=false,f4State=null,f4Coordinator=null,f4Success=null;
function f4Record(s,d){return {recordId:s.recordId,categoryId:s.categoryKey,serviceId:s.serviceCatalogId,serviceName:s.otherServiceName||s.serviceCatalogId,other:s.serviceCatalogId==="other",usageStatus:s.usageStatus==="unanswered"?null:s.usageStatus,intentionOverride:s.intentionOverride,inheritedIntention:effectiveIntention(s,d.categories.find(c=>c.categoryKey===s.categoryKey)),answers:Object.fromEntries(Object.entries(s.answers).filter(([k,v])=>v!=="unanswered")),recordState:s.recordState};}
function f4Hydrate(d){C.forEach(function(c){var p=d?.categories.find(x=>x.categoryKey===c.id);S.status[c.id]=p&&p.usageStatus!=="unanswered"?p.usageStatus:null;S.intent[c.id]=p&&p.intention!=="unanswered"?p.intention:null;});Object.keys(S.quick).forEach(k=>S.quick[k]=d&&d.overview[k]!=="unanswered"?d.overview[k]:null);R2.records=d?d.services.map(s=>f4Record(s,d)):[];if(R2.draft?.recordId){var s=d?.services.find(s=>s.recordId===R2.draft.recordId);if(s)Object.assign(R2.draft,f4Record(s,d));}}
function f4Save(op,done){f4Success=done||null;f4Coordinator.submit(op);}
function f4Add(done){R2.draft.recordId=id('svc');f4Save({type:'addService',recordId:R2.draft.recordId,categoryKey:R2.draft.categoryId,serviceCatalogId:R2.draft.serviceId,otherServiceName:R2.draft.other?R2.draft.serviceName:null},done);}
function f4Status(){var node=document.getElementById('save-status');if(!node){node=E('section','panel');node.id='save-status';node.setAttribute('aria-live','polite');document.getElementById('app').before(node);}node.replaceChildren();node.append(E('p','',f4State?.message||(f4State?.saving?'保存しています…':f4Ready?(f4State?.committed?'端末内に保存済み（長期保持を保証する表示ではありません）':'まだ回答は保存されていません'):'保存機能を確認しています…')));if(f4State?.pending.length){node.append(E('strong','','未保存回答を保持しています。再読み込みすると失われる可能性があります。'));for(const p of f4State.pending)node.append(E('p','',f4PendingLabel(p.operation)));if(f4State.error&&!['conflict','version'].includes(f4State.error)){var retry=E('button','btn secondary','同じ未保存回答を再試行');retry.addEventListener('click',()=>f4Coordinator.retry());node.append(retry);}}if(f4State?.error){var reload=E('button','btn secondary','未保存回答を破棄して再読み込み');reload.addEventListener('click',()=>{if(confirm('画面上の未保存回答を破棄して、保存済みデータを読み込みますか？'))location.reload();});node.append(reload);}document.querySelectorAll('#app button').forEach(b=>{if(!f4Ready||f4State?.saving||f4State?.pending.length)b.disabled=true;});}
const legacyRender=render;render=function(reset){legacyRender(reset);if(S.step===0&&!R2.active){var warning=E('p','danger','プライベートモードでは終了時に整理データが失われる場合があります。通常モードでも長期保存は保証されません。適宜バックアップを推奨します（バックアップ機能は未実装）。');document.getElementById('app').prepend(warning);}f4Status();};
if(typeof document!=='undefined'){
render(true);

window.addEventListener('beforeunload',e=>{if(f4State?.pending.length){e.preventDefault();e.returnValue='';}});
try{const db=await openDatabase();f4Coordinator=new SaveCoordinator(new CanonicalStore(db),state=>{f4State=state;if(!state.pending.length){f4Hydrate(state.committed);const done=f4Success;f4Success=null;if(done)done();}render();});await f4Coordinator.load();f4Ready=true;render();}catch(e){f4State={message:messages[classify(e)],pending:[],saving:false};render();}
}
