  "recipes": [
    {
      "id": "ENUM-EXACT",
      "input": "manifestの全key/enum/presence/condition。unanswered/nullを除外しない",
      "cases": "MAN/R08/R2INT/REG関連。正例全値＋unknown/missing/nested objectの負例",
      "oracle": "approved normative manifest, not SUT output"
    },
    {
      "id": "CONTROL-ALL",
      "codePoints": [
        "U+0000..001F",
        "U+007F",
        "U+0080..009F",
        "U+061C",
        "U+200E",
        "U+200F",
        "U+202A..202E",
        "U+2066..2069"
      ],
      "input": "各code pointを「試験」前後/中央に挿入。Unicode escape・raw textを分離",
      "cases": "TXT-05〜11 / R02-22"
    },
    {
      "id": "UUID-ALL",
      "variants": [
        "lowercase v4 valid",
        "uppercase",
        "braces",
        "v1",
        "v7",
        "invalid variant",
        "prefix typo",
        "duplicate",
        "category ID mismatch",
        "existing collision→fresh",
        "collision×3",
        "generator throw",
        "primary randomUUID",
        "fallback getRandomValues"
      ],
      "cases": "RID/GEN/ID/REG関連"
    },
    {
      "id": "EXACT-BYTES",
      "layers": {
        "canonical": [
          9999999,
          10000000,
          10000001
        ],
        "pending": [
          999999,
          1000000,
          1000001
        ],
        "raw": [
          15999999,
          16000000,
          16000001
        ]
      },
      "input": "FIXTURES.json記載SHA/サイズを確認。canonical新generation/metaの長さもprospective layerで再照合",
      "cases": "CAP/R03/R04。layer通過と全file受理を区別"
    },
    {
      "id": "MISSING-UNKNOWN",
      "input": "root/meta/overview/category/service/answers/pending/operation/context/checksum各objectでrequired1key欠落、unknown1key、__proto__/constructor/prototype、duplicate decoded keyを別byte fixtureへ導入",
      "cases": "CAT/RST/R02/SEC関連。署名再計算版と据置版を分離"
    },
    {
      "id": "TRANSACTION-PHASES",
      "stores": [
        "meta",
        "overview",
        "categories",
        "services"
      ],
      "phases": [
        "GUARD",
        "CLEAR",
        "PUT",
        "READBACK",
        "COMPLETE"
      ],
      "input": "各指定phase/store/first-middle-final request faultを別run。no-op/empty/valid/corruptの前提も個別に記録",
      "cases": "SAVE/DEL/R03/RST関連"
    },
    {
      "id": "REAPPLY-LIFECYCLE",
      "input": "full/partial/none × sourceFileId/snapshotGen/restoredGen/global/operationId/receipt一致不一致、before==after、double tap、op1成功op2abort、reload/実restart、file紛失",
      "cases": "R05/R01/RST関連"
    },
    {
      "id": "ERROR-SIX",
      "variants": [
        "capacity",
        "quota",
        "restricted",
        "conflict",
        "temporary",
        "unknown"
      ],
      "input": "根拠ある例外/根拠不足例外・pendingあり/なし・retry可/不可を分離",
      "cases": "ERR/SAVE関連"
    }
  ]
}
